# Copy to .env and export these before starting. NEVER commit real keys.
ADMIN_EMAIL=admin@millionairefans.local
ADMIN_PASSWORD=change-me-to-something-long
APP_URL=https://your-domain.com
COOKIE_SECURE=1
TRUST_PROXY=1
# Leave empty for test mode (no real money). Add your key to go live.
PAYSTACK_SECRET_KEY=
# FM_DB=/var/data/millionairefans.db
# Real fixtures/results (free key at football-data.org). Empty = demo data.
FOOTBALL_DATA_API_KEY=

# Email through Google (Gmail). Turn on 2-step verification, then create an "App password" in your Google account.
# Use that 16-character app password here, NOT your normal Gmail password.
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM_NAME=Millionaire Fans
# MAIL_DEBUG_LOG=0   # 1 = DEV ONLY: print emails (including reset links) to the log when email is not set up
